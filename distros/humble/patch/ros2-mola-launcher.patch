diff --git a/src/MolaDLL_Loader.cpp b/src/MolaDLL_Loader.cpp
index bef3f5b..1cd163d 100644
--- a/src/MolaDLL_Loader.cpp
+++ b/src/MolaDLL_Loader.cpp
@@ -81,6 +81,9 @@ void internal_load_lib_modules(
     for (const auto& lib : lst)
     {
       if (lib.name.find("mola") == std::string::npos) continue;  // skip
+      // ROS interface libraries (e.g. mola_msgs) are never MOLA modules, and the
+      // Python ones cannot be dlopen()ed from a non-Python process:
+      if (lib.name.find("__rosidl_") != std::string::npos) continue;  // skip
 
       // Already loaded?
       if (loaded_lib_handled.count(lib.name) != 0) continue;  // skip
diff --git a/src/MolaLauncherApp.cpp b/src/MolaLauncherApp.cpp
index 841913c..85407a4 100644
--- a/src/MolaLauncherApp.cpp
+++ b/src/MolaLauncherApp.cpp
@@ -120,6 +120,18 @@ MolaLauncherApp::MolaLauncherApp() : mrpt::system::COutputLogger("MolaLauncherAp
   // do not filter these ones by *directory* name, since *filenames* will be
   // filtered later on:
   from_env_var_to_list("LD_LIBRARY_PATH", lib_search_paths_);
+
+  // conda/RoboStack environments do not set LD_LIBRARY_PATH: also search
+  // <prefix>/lib (<prefix>/bin for Windows DLLs) for every prefix in AMENT_PREFIX_PATH.
+  {
+    std::vector<std::string> prefixes;
+    from_env_var_to_list("AMENT_PREFIX_PATH", prefixes);
+#if defined(_WIN32)
+    for (const auto& prefix : prefixes) safe_add_to_list(prefix + "/bin", lib_search_paths_);
+#else
+    for (const auto& prefix : prefixes) safe_add_to_list(prefix + "/lib", lib_search_paths_);
+#endif
+  }
 }
 
 MolaLauncherApp::~MolaLauncherApp()
