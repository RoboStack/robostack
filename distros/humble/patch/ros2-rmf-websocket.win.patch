diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2cef478..63aab06 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,12 @@ if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wextra -Wpedantic")
 endif()
 
+if(MSVC)
+  # websocketpp's C++11 feature detection reads __cplusplus, which MSVC only reports
+  # correctly with /Zc:__cplusplus (otherwise it falls back to boost::is_same, gone from Boost).
+  add_compile_options(/Zc:__cplusplus)
+endif()
+
 include(GNUInstallDirs)
 
 find_package(ament_cmake REQUIRED)
@@ -28,6 +34,14 @@ find_package(Threads)
 file(GLOB_RECURSE core_lib_srcs "src/rmf_websocket/*.cpp")
 add_library(rmf_websocket SHARED ${core_lib_srcs})
 
+if(MSVC)
+  # No explicit dllexport annotations anywhere in this small target, so
+  # without this MSVC produces the .dll but no companion .lib, and
+  # example_client fails with LNK1181.
+  set_target_properties(rmf_websocket PROPERTIES
+    WINDOWS_EXPORT_ALL_SYMBOLS ON)
+endif()
+
 target_link_libraries(rmf_websocket
   PUBLIC
     ${rclcpp_LIBRARIES}
