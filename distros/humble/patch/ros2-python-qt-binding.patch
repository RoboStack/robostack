+        # QModelIndex.child(row, column), removed in Qt 6
+        if not hasattr(QtCore.QModelIndex, 'child'):
+            def _child(self, row, column):
+                model = self.model()
+                return model.index(row, column, self) if model is not None else QtCore.QModelIndex()
+            QtCore.QModelIndex.child = _child
+        # QSortFilterProxyModel.filterRegExp / setFilterRegExp: Qt 6 only has the
+        # QRegularExpression variants (the QRegExp above is one)
+        proxy = getattr(QtCore, 'QSortFilterProxyModel', None)
+        if proxy is not None and not hasattr(proxy, 'filterRegExp'):
+            def _filter_regexp(self):
+                regex = self.filterRegularExpression()
+                return QtCore.QRegExp(regex.pattern(), self.filterCaseSensitivity())
