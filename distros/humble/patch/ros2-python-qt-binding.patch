+            def _set_filter_regexp(self, regex):
+                if not isinstance(regex, QtCore.QRegularExpression):
+                    regex = QtCore.QRegExp(regex)
+                self.setFilterRegularExpression(regex)
+            proxy.filterRegExp = _filter_regexp
+            proxy.setFilterRegExp = _set_filter_regexp
+        # QSignalMapper.mapped[int / str / QObject]: Qt 6 has mappedInt, mappedString, mappedObject
+        if hasattr(QtCore, 'QSignalMapper') and not hasattr(QtCore.QSignalMapper, 'mapped'):
+            class _Mapped(object):
+                def __init__(self, mapper):
+                    self._mapper = mapper
+
+                def __getitem__(self, signal_type):
+                    if signal_type is int:
+                        return self._mapper.mappedInt
+                    if signal_type is str:
+                        return self._mapper.mappedString
+                    return self._mapper.mappedObject
+
+                def connect(self, slot):
