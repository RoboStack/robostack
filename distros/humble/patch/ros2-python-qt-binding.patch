+    - a few Qt 5 methods Qt 6 dropped, as their replacements
+    """
+    import enum
+
+    modules = [sys.modules[name] for name in ('QtCore', 'QtGui', 'QtWidgets', 'QtSvg',
+               'QtOpenGL', 'QtOpenGLWidgets', 'QtNetwork', 'QtPrintSupport') if name in sys.modules]
+    for module in modules:
+        for class_name in dir(module):
+            if not class_name.startswith('Q'):
+                continue
+            cls = getattr(module, class_name)
+            # module-level enums (QtCore.QtMsgType: QtCore.QtCriticalMsg, ...)
+            if isinstance(cls, enum.EnumMeta):
+                for name, member in cls.__members__.items():
+                    if not hasattr(module, name):
+                        setattr(module, name, member)
+                continue
+            if not isinstance(cls, type):
+                continue
+            for attr_name in dir(cls):
+                if not attr_name[:1].isupper():
+                    continue
+                attr = getattr(cls, attr_name, None)
+                if isinstance(attr, enum.EnumMeta):
+                    # int(enum value), as with PyQt5's int-like enums
+                    if not issubclass(attr, int) and '__int__' not in attr.__dict__:
