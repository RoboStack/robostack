index 0000000..934af4e
--- /dev/null
+++ b/cmake/fixup_sip_module_name.py
@@ -0,0 +1,31 @@
+#!/usr/bin/env python3
+"""Copy PyQt-builder's ABI-tagged sip module to the plain name CMake expects.
+
+PyQt-builder's pip-based wheel install places the compiled module under a
+Python-ABI-tagged filename using Python's own extension suffix (e.g.
+libfoo.cpython-312-x86_64-linux-gnu.so -- always .so, even on macOS, since
+that's the suffix CPython's import machinery requires for C extensions)
+rather than the plain lib${PROJECT_NAME}${CMAKE_SHARED_LIBRARY_SUFFIX} that
+build_sip_binding()'s callers (and the install() step) expect -- which on
+macOS is .dylib, not .so. So the match can't assume the same extension as
+`want`; only the base name is reliable. Searches recursively since pip
+--target layout can nest the module in a subdirectory, and fails loudly
+(rather than leaving a confusing later "file INSTALL cannot find" CMake
+error) when nothing matches.
+"""
+import glob
+import os
+import shutil
+import sys
+
+library_dir, want = sys.argv[1], sys.argv[2]
+base = os.path.splitext(want)[0]
+pattern = base + '.*'
+hits = [
+    f for f in glob.glob(os.path.join(library_dir, '**', pattern), recursive=True)
+    if os.path.basename(f) != want
+]
+if hits:
+    shutil.copyfile(hits[0], os.path.join(library_dir, want))
+else:
+    available = []
