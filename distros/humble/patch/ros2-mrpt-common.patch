diff --git a/cmake/mrpt_cmake_functions.cmake b/cmake/mrpt_cmake_functions.cmake
index 87ec9fe..6603aa4 100644
--- a/cmake/mrpt_cmake_functions.cmake
+++ b/cmake/mrpt_cmake_functions.cmake
@@ -79,6 +79,21 @@ if(NOT MSVC AND NOT XCODE_VERSION)
     endif()
 endif()
 
+# RoboStack: conda's CMAKE_ARGS pass the binutils as bare program names
+# (-DCMAKE_AR=<triplet>-ar, ...); MRPT's projects end up with them cached as paths
+# in the build directory, which don't exist (seen on linux-aarch64): static
+# libraries (bundled cloudini in mrpt_maps) and pybind11's strip step then fail.
+foreach(_mrpt_tool CMAKE_AR CMAKE_RANLIB CMAKE_STRIP CMAKE_NM CMAKE_OBJCOPY CMAKE_OBJDUMP CMAKE_READELF CMAKE_ADDR2LINE)
+  if(${_mrpt_tool} AND NOT EXISTS "${${_mrpt_tool}}")
+    get_filename_component(_mrpt_tool_name "${${_mrpt_tool}}" NAME)
+    find_program(_mrpt_tool_path NAMES "${_mrpt_tool_name}" NO_CACHE)
+    if(_mrpt_tool_path)
+      set(${_mrpt_tool} "${_mrpt_tool_path}" CACHE FILEPATH "" FORCE)
+    endif()
+    unset(_mrpt_tool_path)
+  endif()
+endforeach()
+
 # Static library options:
 set(DISABLE_MRPT_AUTO_CLASS_REGISTRATION OFF CACHE BOOL "Enable to reduce the footprint of MRPT statically libraries linked; caution: all deserialized classes must be registered by hand by the user!")
 mark_as_advanced(DISABLE_MRPT_AUTO_CLASS_REGISTRATION)
@@ -495,7 +510,10 @@ function(handle_special_simd_flags lst_files FILE_PATTERN FLAGS_TO_ADD)
     keep_matching_files_from_list(${FILE_PATTERN} _lst)
     if(NOT "${_lst}" STREQUAL "")
       #message(STATUS "Adding special flags ${FLAGS_TO_ADD} to ${_lst}")
-      set_source_files_properties(${_lst} PROPERTIES COMPILE_FLAGS "${FLAGS_TO_ADD}")
+      # RoboStack: without the precompiled header, which is built without these flags (clang
+      # rejects a PCH built for other target features, e.g. -msse2 on osx-64)
+      set_source_files_properties(${_lst} PROPERTIES COMPILE_FLAGS "${FLAGS_TO_ADD}"
+        SKIP_PRECOMPILE_HEADERS ON)
     endif()
   endif()
 endfunction()
