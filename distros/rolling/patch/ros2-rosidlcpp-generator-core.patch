-#include <nlohmann/json_fwd.hpp>
+#include <nlohmann/json.hpp>
+
+#include <fmt/format.h>
+
+// fmt 12 can't format nlohmann::json values on clang (GCC gets there through the implicit
+// conversion to std::string): format strings as their value, everything else as JSON
+template <>
+struct fmt::formatter<nlohmann::json> : fmt::formatter<std::string> {
+  auto format(const nlohmann::json& j, fmt::format_context& ctx) const {
+    return fmt::formatter<std::string>::format(j.is_string() ? j.get<std::string>() : j.dump(), ctx);
+  }
+};
 
