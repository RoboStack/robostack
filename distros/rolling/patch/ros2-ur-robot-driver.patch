-std::vector<hardware_interface::StateInterface> URPositionHardwareInterface::export_state_interfaces()
+std::vector<hardware_interface::StateInterface::ConstSharedPtr>
+URPositionHardwareInterface::on_export_state_interfaces()
+{
+  std::vector<hardware_interface::StateInterface::ConstSharedPtr> state_interfaces;
+  state_links_.clear();
+  for (const auto& link : export_state_links()) {
+    hardware_interface::InterfaceInfo info;
+    info.name = link.name;
+    auto handle = std::make_shared<hardware_interface::StateInterface>(
+        hardware_interface::InterfaceDescription(link.prefix, info));
+    state_links_.emplace_back(handle, link.value);
+    state_interfaces.push_back(handle);
+  }
+  return state_interfaces;
+}
+
+std::vector<hardware_interface::CommandInterface::SharedPtr> URPositionHardwareInterface::on_export_command_interfaces()
+{
+  std::vector<hardware_interface::CommandInterface::SharedPtr> command_interfaces;
+  command_links_.clear();
+  async_links_.clear();
+  for (const auto& link : export_command_links()) {
+    hardware_interface::InterfaceInfo info;
+    info.name = link.name;
+    auto handle = std::make_shared<hardware_interface::CommandInterface>(
+        hardware_interface::InterfaceDescription(link.prefix, info));
+    if (is_async_member(link.value)) {
+      // the handle is the storage: no new command until a controller writes one
+      std::ignore = handle->set_value(NO_NEW_CMD_);
+      const bool success_flag = link.name.size() >= 13 && link.name.rfind("async_success") == link.name.size() - 13;
+      async_links_.push_back({ handle, link.value, NO_NEW_CMD_, success_flag, false });
+    } else {
+      std::ignore = handle->set_value(*link.value);
+      command_links_.push_back({ handle, link.value, *link.value });
+    }
+    command_interfaces.push_back(handle);
+  }
+  // the request resets are published before the success flags (push_async())
+  std::stable_partition(async_links_.begin(), async_links_.end(),
+                        [](const AsyncLink& link) { return !link.success_flag; });
+  async_retries_.reserve(async_links_.size());  // no allocation in the control loop
+  return command_interfaces;
+}
+
+namespace
+{
+// NO_NEW_CMD_ is NaN, which never compares equal to itself
+bool same(double a, double b)
+{
+  return std::memcmp(&a, &b, sizeof(double)) == 0;
+}
+
+// marks a success flag checkAsyncIO() didn't write (it only ever assigns them): a NaN that is
+// neither NO_NEW_CMD_ nor anything it assigns
+double unwritten()
+{
+  const uint64_t bits = 0x7ff800000000beefULL;
+  double value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+}  // namespace
+
+// a command a controller wrote to its handle since the last sync goes to the member
+void URPositionHardwareInterface::pull_commands()
+{
+  for (auto& link : command_links_) {
+    double command;
+    if (link.handle->get_value(command, false) && !same(command, link.synced) && same(*link.value, link.synced)) {
+      *link.value = command;
+      link.synced = command;
+    }
+  }
+}
+
+// the states, and the commands the driver itself changed since the last sync, go to the handles
+void URPositionHardwareInterface::push_states_and_commands()
+{
+  for (auto& [handle, value] : state_links_) {
+    std::ignore = handle->set_value(*value);
+  }
+  for (auto& link : command_links_) {
+    // one read: other threads (e.g. trajectory_done_callback()) may change the member meanwhile
+    const double value = *link.value;
+    if (!same(value, link.synced) && link.handle->set_value(value)) {
+      link.synced = value;
+    }
+  }
+}
+
+bool URPositionHardwareInterface::is_async_member(const double* value) const
+{
+  auto in = [value](const auto& member) {
+    const double* begin = reinterpret_cast<const double*>(&member);
+    return value >= begin && value < begin + sizeof(member) / sizeof(double);
+  };
+  return in(standard_dig_out_bits_cmd_) || in(standard_analog_output_cmd_) || in(analog_output_domain_cmd_) ||
+         in(tool_voltage_cmd_) || in(io_async_success_) || in(target_speed_fraction_cmd_) ||
+         in(scaling_async_success_) || in(resend_robot_program_cmd_) || in(resend_robot_program_async_success_) ||
+         in(hand_back_control_cmd_) || in(hand_back_control_async_success_) || in(payload_mass_) ||
+         in(payload_center_of_gravity_) || in(payload_inertia_) || in(payload_transition_time_) ||
+         in(payload_async_success_) || in(gravity_vector_) || in(gravity_async_success_) ||
+         in(friction_model_viscous_) || in(friction_model_coulomb_) || in(friction_model_async_success_) ||
+         in(zero_ftsensor_cmd_) || in(zero_ftsensor_async_success_) || in(freedrive_mode_enable_) ||
+         in(freedrive_mode_abort_) || in(freedrive_mode_async_success_);
+}
+
+// the requests as the controllers and services left them, into the async thread's members; the
+// success flags are marked, so that push_async() publishes every one checkAsyncIO() writes (also
+// when the result equals the previous one, as for a request that followed an earlier success)
+bool URPositionHardwareInterface::pull_async()
+{
+  // all requests or none: checkAsyncIO() must not act on a request of which only some values were read
+  std::vector<double> values(async_links_.size());
+  for (size_t i = 0; i < async_links_.size(); ++i) {
+    const auto& link = async_links_[i];
+    if (!link.pending && !link.success_flag && !link.handle->get_value(values[i], false)) {
+      return false;
+    }
+  }
+  for (size_t i = 0; i < async_links_.size(); ++i) {
+    auto& link = async_links_[i];
+    if (link.pending) {
+      continue;  // keeps the value it couldn't publish yet
+    }
+    if (link.success_flag) {
+      *link.value = unwritten();
+    } else {
+      *link.value = values[i];
+      link.pulled = values[i];
+    }
+  }
+  return true;
+}
+
+// what checkAsyncIO() did, back to the handles: the request resets first, the success flags only once
+// those are all published; anything that couldn't be published is retried next time
+void URPositionHardwareInterface::push_async()
+{
+  bool resets_published = true;
+  for (auto& link : async_links_) {
+    const double value = *link.value;
+    if (link.success_flag) {
+      if (!link.pending && same(value, unwritten())) {
+        continue;
+      }
+      link.pending = !(resets_published && link.handle->set_value(value));
+      continue;
+    }
+    if (link.pending) {
+      // a newer request arrived meanwhile: it wins over the reset of the old one
+      double current;
+      if (link.handle->get_value(current, false) && !same(current, link.pulled)) {
+        link.pending = false;
+        link.pulled = value;  // so that a failed pull can't bring the dropped reset back
+        continue;
+      }
+    } else if (same(value, link.pulled)) {
+      continue;
+    }
+    link.pending = !link.handle->set_value(value);
+    if (link.pending) {
+      resets_published = false;
+    } else {
+      link.pulled = value;
+    }
+  }
+}
+
+// a reset from the control loop thread (initialisation, mode switch) straight to the handle,
+// without waiting for its lock: if it is taken, the control loop retries (retry_set_async())
+void URPositionHardwareInterface::set_async(const double& member, double value)
+{
+  for (auto& link : async_links_) {
+    if (link.value == &member) {
+      if (!link.handle->set_value(value)) {
+        async_retries_.emplace_back(link.handle, value);
+      }
+      return;
+    }
+  }
+}
+
+void URPositionHardwareInterface::retry_set_async()
+{
+  async_retries_.erase(std::remove_if(async_retries_.begin(), async_retries_.end(),
+                                      [](const auto& retry) { return retry.first->set_value(retry.second); }),
+                       async_retries_.end());
+}
+
+hardware_interface::return_type URPositionHardwareInterface::read(const rclcpp::Time& time,
+                                                                  const rclcpp::Duration& period)
+{
+  retry_set_async();
+  pull_commands();
+  const auto result = read_impl(time, period);
+  push_states_and_commands();
+  return result;
+}
+
+hardware_interface::return_type URPositionHardwareInterface::write(const rclcpp::Time& time,
+                                                                   const rclcpp::Duration& period)
+{
+  retry_set_async();
+  pull_commands();
+  const auto result = write_impl(time, period);
+  push_states_and_commands();
+  return result;
+}
