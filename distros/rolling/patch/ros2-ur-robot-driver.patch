+         "pos_x",        "pos_y",     "pos_z",        "pos_qx",     "pos_qy",     "pos_qz",     "pos_qw",
+         "pos_via_x",    "pos_via_y", "pos_via_z",    "pos_via_qx", "pos_via_qy", "pos_via_qz", "pos_via_qw",
+         "blend_radius", "velocity",  "acceleration", "move_time" }) {
+    expected_names.push_back(std::string(kTfPrefix) + "motion_primitive/" + name);
+  }
+
+  EXPECT_THAT(exported_names, ::testing::UnorderedElementsAreArray(expected_names));
+}
+
+TEST_F(URHardwareInterfaceExportTest, ExportsPassthroughProtocolInterfacesAsDoubles)
+{
+  const auto command_interfaces = hw_->export_command_interfaces();
+  const auto state_interfaces = hw_->export_state_interfaces();
+  const auto find_interface = [](const auto& interfaces, const std::string& name) {
+    return std::find_if(interfaces.begin(), interfaces.end(),
+                        [&name](const auto& interface) { return interface->get_name() == name; });
+  };
+
+  const std::string prefix = std::string(kTfPrefix) + "trajectory_passthrough/";
+  EXPECT_TRUE((*find_interface(command_interfaces, prefix + "transfer_state"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(command_interfaces, prefix + "transfer_sequence"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(command_interfaces, prefix + "trajectory_size"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(command_interfaces, prefix + "abort"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(state_interfaces, prefix + "transfer_state"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(state_interfaces, prefix + "transfer_sequence"))->get_optional<double>());
+  EXPECT_TRUE((*find_interface(state_interfaces, prefix + "abort"))->get_optional<double>());
+}
+
+TEST(URHardwareInterfaceExport, SupportsDescriptionsWithoutEffortCommands)
+{
+  auto info = BuildTestHardwareInfo();
+  for (auto& joint : info.joints) {
+    joint.command_interfaces.erase(
+        std::remove_if(joint.command_interfaces.begin(), joint.command_interfaces.end(),
+                       [](const auto& interface) { return interface.name == hardware_interface::HW_IF_EFFORT; }),
+        joint.command_interfaces.end());
+  }
+
+  hardware_interface::HardwareComponentParams params;
+  params.hardware_info = info;
+  params.clock = std::make_shared<rclcpp::Clock>();
+  params.logger = rclcpp::get_logger("test_ur_hardware_interface_without_effort_commands");
+
+  hardware_interface::System hardware(std::make_unique<ur_robot_driver::URPositionHardwareInterface>());
+  const auto state = hardware.initialize(params);
+  ASSERT_EQ(state.id(), lifecycle_msgs::msg::State::PRIMARY_STATE_UNCONFIGURED);
+
+  const auto exported_names = GetNames(hardware.export_command_interfaces());
+  for (size_t i = 1; i <= kJointCount; ++i) {
+    EXPECT_THAT(exported_names, ::testing::Not(::testing::Contains("joint_" + std::to_string(i) + "/" +
+                                                                   hardware_interface::HW_IF_EFFORT)));
+  }
+}
+
+int main(int argc, char** argv)
+{
+  rclcpp::init(argc, argv);
+  testing::InitGoogleMock(&argc, argv);
+  int result = RUN_ALL_TESTS();
+  rclcpp::shutdown();
+  return result;
+}
