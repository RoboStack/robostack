diff --git a/cmake_modules/FindEigen3.cmake b/cmake_modules/FindEigen3.cmake
index 0b36805..515d056 100644
--- a/cmake_modules/FindEigen3.cmake
+++ b/cmake_modules/FindEigen3.cmake
@@ -1,3 +1,15 @@
+# RoboStack: Eigen 5 moved its version macros out of Eigen/src/Core/util/Macros.h, which
+# this module reads; use Eigen's own CMake config when there is one
+find_package(Eigen3 CONFIG QUIET)
+if(Eigen3_FOUND)
+  get_target_property(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
+  set(EIGEN3_INCLUDE_DIRS ${EIGEN3_INCLUDE_DIR})
+  set(EIGEN3_VERSION ${Eigen3_VERSION})
+  set(EIGEN3_FOUND TRUE)
+  set(EIGEN3_VERSION_OK TRUE)
+  return()
+endif()
+
 # - Try to find Eigen3 lib
 #
 # This module supports requiring a minimum version, e.g. you can do
