+def _make_qregexp(QtCore):
+    """Qt 5's QRegExp, on QRegularExpression (the parts plugins use)."""
+    QRegularExpression = QtCore.QRegularExpression
+    CaseInsensitive = QtCore.Qt.CaseSensitivity.CaseInsensitive
+
+    class QRegExp(QRegularExpression):
+        RegExp, Wildcard, FixedString, RegExp2, WildcardUnix, W3CXmlSchema11 = range(6)
+        # QRegExp.PatternSyntax(n): the syntax values are plain ints here
+        PatternSyntax = int
+
+        def __init__(self, pattern='', cs=QtCore.Qt.CaseSensitivity.CaseSensitive, syntax=0):
+            if isinstance(pattern, QRegularExpression):
+                pattern = pattern.pattern()
+            self._source, self._syntax, self._captures = pattern, syntax, []
+            if syntax in (QRegExp.Wildcard, QRegExp.WildcardUnix):
+                pattern = QRegularExpression.wildcardToRegularExpression(pattern)
+            elif syntax == QRegExp.FixedString:
+                pattern = QRegularExpression.escape(pattern)
+            options = QRegularExpression.PatternOption.NoPatternOption
+            if cs == CaseInsensitive:
+                options = QRegularExpression.PatternOption.CaseInsensitiveOption
+            super(QRegExp, self).__init__(pattern, options)
+
+        def _keep(self, match):
+            self._captures = list(match.capturedTexts()) if match.hasMatch() else []
+            return match
+
+        def exactMatch(self, text):
+            whole = QRegularExpression(
+                QRegularExpression.anchoredPattern(self.pattern()), self.patternOptions())
+            return self._keep(whole.match(text)).hasMatch()
+
+        def indexIn(self, text, offset=0):
+            match = self._keep(self.match(text, offset))
+            return match.capturedStart(0) if match.hasMatch() else -1
+
+        def cap(self, n=0):
+            return self._captures[n] if n < len(self._captures) else ''
+
+        def capturedTexts(self):
+            return list(self._captures)
+
+        def matchedLength(self):
+            return len(self._captures[0]) if self._captures else -1
+
+        def isEmpty(self):
+            return not self._source
+
+        def setCaseSensitivity(self, cs):
+            options = self.patternOptions()
+            if cs == CaseInsensitive:
+                options |= QRegularExpression.PatternOption.CaseInsensitiveOption
+            else:
+                options &= ~QRegularExpression.PatternOption.CaseInsensitiveOption
+            self.setPatternOptions(options)
+
+        def caseSensitivity(self):
+            if self.patternOptions() & QRegularExpression.PatternOption.CaseInsensitiveOption:
+                return CaseInsensitive
+            return QtCore.Qt.CaseSensitivity.CaseSensitive
+
+    return QRegExp
+
+
+def _qt5_compatibility():
+    """Let code written for PyQt5 (noetic's plugins) run on PyQt6 (RoboStack).
+
+    - enum values also as attributes of their class (Qt.AlignLeft, not only
+      Qt.AlignmentFlag.AlignLeft), as PyQt5 had them
+    - exec_() next to exec()
+    - the classes Qt 6 moved from QtWidgets to QtGui also in QtWidgets
+    - a few Qt 5 methods Qt 6 dropped, as their replacements
+    """
+    import enum
+
+    modules = [sys.modules[name] for name in ('QtCore', 'QtGui', 'QtWidgets', 'QtSvg',
+               'QtOpenGL', 'QtOpenGLWidgets', 'QtNetwork', 'QtPrintSupport') if name in sys.modules]
+    for module in modules:
+        for class_name in dir(module):
+            if not class_name.startswith('Q'):
+                continue
+            cls = getattr(module, class_name)
+            # module-level enums (QtCore.QtMsgType: QtCore.QtCriticalMsg, ...)
+            if isinstance(cls, enum.EnumMeta):
+                for name, member in cls.__members__.items():
+                    if not hasattr(module, name):
+                        setattr(module, name, member)
+                continue
+            if not isinstance(cls, type):
+                continue
+            for attr_name in dir(cls):
+                if not attr_name[:1].isupper():
+                    continue
+                attr = getattr(cls, attr_name, None)
+                if isinstance(attr, enum.EnumMeta):
+                    # int(enum value), as with PyQt5's int-like enums
+                    if not issubclass(attr, int) and '__int__' not in attr.__dict__:
+                        try:
+                            attr.__int__ = lambda self: int(self.value)
+                            attr.__index__ = lambda self: int(self.value)
+                        except (AttributeError, TypeError):
+                            pass
+                    # __members__: also aliases and flag combinations (Qt.AllDockWidgetAreas)
+                    for name, member in attr.__members__.items():
+                        if name not in cls.__dict__:
+                            try:
+                                setattr(cls, name, member)
+                            except (AttributeError, TypeError):
+                                pass
+            if 'exec' in dir(cls) and 'exec_' not in dir(cls):
+                try:
+                    cls.exec_ = cls.exec
+                except (AttributeError, TypeError):
+                    pass
+
+    QtCore = sys.modules.get('QtCore')
+    QtGui = sys.modules.get('QtGui')
+    QtWidgets = sys.modules.get('QtWidgets')
+    if QtCore is not None:
+        if not hasattr(QtCore.Qt, 'MidButton'):
+            QtCore.Qt.MidButton = QtCore.Qt.MouseButton.MiddleButton
+        # Qt.CTRL + Qt.Key_S (Qt 5 ints): Qt 6 combines a modifier and a key into a
+        # QKeyCombination (Qt.ControlModifier | Qt.Key_S), which QKeySequence and QShortcut take
+        if hasattr(QtCore, 'QKeyCombination'):
+            Qt = QtCore.Qt
+
+            def _key_add(self, other):
+                if isinstance(other, (Qt.Modifier, Qt.KeyboardModifier)):
+                    return Qt.KeyboardModifier(int(self.value) | int(other.value))
+                if isinstance(other, Qt.Key):
+                    return QtCore.QKeyCombination(Qt.KeyboardModifier(int(self.value)), other)
+                return NotImplemented
+            for modifier_enum in (Qt.Modifier, Qt.KeyboardModifier):
+                try:
+                    modifier_enum.__add__ = _key_add
+                    modifier_enum.__radd__ = _key_add
+                except (AttributeError, TypeError):
+                    pass
+        # QMutex(QMutex.Recursive): Qt 6 has QRecursiveMutex instead
+        if not hasattr(QtCore.QMutex, 'Recursive') and hasattr(QtCore, 'QRecursiveMutex'):
+            class QMutex(QtCore.QMutex):
+                NonRecursive = 0
+                Recursive = 1
+
+                def __new__(cls, mode=0):
+                    if mode == 1:
+                        return QtCore.QRecursiveMutex()
+                    return super().__new__(cls)
+
+                def __init__(self, mode=0):
+                    super().__init__()
+            QtCore.QMutex = QMutex
+        # QRegExp (gone from Qt 6's QtCore): a QRegularExpression with QRegExp's API, so that
+        # it also works where Qt 6 takes a QRegularExpression (findChildren, validators)
+        if not hasattr(QtCore, 'QRegExp'):
+            QtCore.QRegExp = _make_qregexp(QtCore)
+        # QModelIndex.child(row, column), removed in Qt 6
+        if not hasattr(QtCore.QModelIndex, 'child'):
+            def _child(self, row, column):
+                model = self.model()
+                return model.index(row, column, self) if model is not None else QtCore.QModelIndex()
+            QtCore.QModelIndex.child = _child
+        # QSortFilterProxyModel.filterRegExp / setFilterRegExp: Qt 6 only has the
+        # QRegularExpression variants (the QRegExp above is one)
+        proxy = getattr(QtCore, 'QSortFilterProxyModel', None)
+        if proxy is not None and not hasattr(proxy, 'filterRegExp'):
+            def _filter_regexp(self):
+                regex = self.filterRegularExpression()
