diff --git a/boost_system_compat/boost_system-config-version.cmake b/boost_system_compat/boost_system-config-version.cmake
new file mode 100644
index 0000000..9a546ef
--- /dev/null
+++ b/boost_system_compat/boost_system-config-version.cmake
@@ -0,0 +1,4 @@
+# any Boost version asks for it (BoostConfig.cmake asks for its own, EXACT)
+set(PACKAGE_VERSION "${PACKAGE_FIND_VERSION}")
+set(PACKAGE_VERSION_COMPATIBLE TRUE)
+set(PACKAGE_VERSION_EXACT TRUE)
diff --git a/boost_system_compat/boost_system-config.cmake b/boost_system_compat/boost_system-config.cmake
new file mode 100644
index 0000000..9cea055
--- /dev/null
+++ b/boost_system_compat/boost_system-config.cmake
@@ -0,0 +1,11 @@
+# RoboStack: Boost.System is header-only since Boost 1.69, and Boost 1.89 dropped its
+# CMake component (and library). ROS 1 packages still ask for it
+# (find_package(Boost REQUIRED COMPONENTS system ...)): this stands in for it, as
+# Boost::system, an interface target on the Boost headers.
+if(NOT TARGET Boost::system)
+  add_library(Boost::system INTERFACE IMPORTED)
+  if(TARGET Boost::headers)
+    set_target_properties(Boost::system PROPERTIES INTERFACE_LINK_LIBRARIES Boost::headers)
+  endif()
+endif()
+set(boost_system_FOUND TRUE)
diff --git a/cmake/all.cmake b/cmake/all.cmake
index 7768f96..26ad7e7 100644
--- a/cmake/all.cmake
+++ b/cmake/all.cmake
@@ -224,3 +224,40 @@ endif()
 
 # requires stamp and environment files
 include(${catkin_EXTRAS_DIR}/catkin_python_setup.cmake)
+
+# RoboStack: no C++ standard below C++14 (see robostack_cxx_standard.cmake)
+include(${catkin_EXTRAS_DIR}/robostack_cxx_standard.cmake)
+_robostack_drop_old_cxx_standard()
+
+# RoboStack: the Eigen 3.x variables Eigen 5 no longer sets (see robostack_eigen3.cmake)
+include(${catkin_EXTRAS_DIR}/robostack_eigen3.cmake)
+_robostack_eigen3_variables()
+
+# RoboStack: Qt 5 requests get Qt 6 (see robostack_qt5_compat.cmake)
+include(${catkin_EXTRAS_DIR}/robostack_qt5_compat.cmake)
+
+# RoboStack: clang >= 19 rejects `template` before a name without template arguments
+# (-Wmissing-template-arg-list-after-template-kw), which older ROS 1 code has
+if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  include(CheckCXXCompilerFlag)
+  check_cxx_compiler_flag(-Wno-missing-template-arg-list-after-template-kw _robostack_has_template_kw_flag)
+  if(_robostack_has_template_kw_flag)
+    add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-missing-template-arg-list-after-template-kw>)
+  endif()
+  # and `register`, an error in C++17 (the standard here, see robostack_cxx_standard.cmake)
+  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:-Wno-register>)
+endif()
+
+# RoboStack: fmt (log4cxx, spdlog, ...) needs MSVC's /utf-8 (fmt/base.h: "Unicode
+# support requires compiling with /utf-8"), and ROS 1 packages include it through them
+if(MSVC)
+  add_compile_options($<$<COMPILE_LANGUAGE:CXX>:/utf-8>)
+endif()
+
+# RoboStack: conda-forge's Boost is shared only on Windows; its data (program_options'
+# arg, ...) needs __declspec(dllimport), which the Boost:: targets get through
+# BOOST_<lib>_DYN_LINK but packages linking ${Boost_LIBRARIES} don't. BOOST_ALL_NO_LIB, as
+# the targets set it too: no auto-linking (decorated names conda-forge doesn't install)
+if(WIN32)
+  add_compile_definitions(BOOST_ALL_DYN_LINK BOOST_ALL_NO_LIB)
+endif()
diff --git a/cmake/catkinConfig.cmake.in b/cmake/catkinConfig.cmake.in
index 4d014f5..1c96886 100644
--- a/cmake/catkinConfig.cmake.in
+++ b/cmake/catkinConfig.cmake.in
@@ -10,6 +10,14 @@
 # :outvar <comp>_INCLUDE_DIRS/_LIBRARY_DIRS/_LIBRARIES:
 #    contains the include dirs / library dirs / libraries of the searched component <comp>.
 
+# RoboStack: catkin's find_package override (robostack_eigen3.cmake) is a macro, which
+# parses its arguments again: keep the backslashes of Windows paths (CMAKE_PREFIX_PATH)
+# in them, instead of reading them as escapes (\b, ...). Config files have their own
+# policy scope, so this doesn't change the package's policies.
+if(POLICY CMP0219)
+  cmake_policy(SET CMP0219 NEW)
+endif()
+
 if(CATKIN_TOPLEVEL_FIND_PACKAGE OR NOT CATKIN_TOPLEVEL)
   set(catkin_EXTRAS_DIR "@PKG_CMAKE_DIR@")
 
diff --git a/cmake/catkin_libraries.cmake b/cmake/catkin_libraries.cmake
index b19f4c8..5d9a24c 100644
--- a/cmake/catkin_libraries.cmake
+++ b/cmake/catkin_libraries.cmake
@@ -114,6 +114,40 @@ function(catkin_unpack_libraries_with_build_configuration VAR)
   set(${VAR} "${result}" PARENT_SCOPE)
 endfunction()
 
+#
+# Find libraries by imported location or soname with location dir as hint
+#
+# :param VAR: the output variable name
+# :type VAR: string
+# :param LIB: the imported target to find the library for
+# :type LIB: string
+# :type ARGN: selected config to query in the target's properties
+# :type ARGN: string
+#
+# @public
+#
+function(catkin_find_library_imported_location_library VAR LIB)
+  set(lib ${LIB})
+  if(ARGN)
+    set(cfg _${ARGN})
+  endif()
+  set(imported_location_libnames)
+  get_target_property(imported_soname ${lib} IMPORTED_SONAME${cfg})
+  if(imported_soname)
+    list(APPEND imported_location_libnames ${imported_soname})
+  endif()
+  get_target_property(imported_location ${lib} IMPORTED_LOCATION${cfg})
+  if(imported_location)
+    get_filename_component(imported_location_name ${imported_location} NAME)
+    get_filename_component(imported_location_dir ${imported_location} DIRECTORY)
+    list(APPEND imported_location_libnames ${imported_location_name})
+  endif()
+  if(imported_location_libnames)
+    find_library(imported_location_library NAMES ${imported_location_libnames} HINTS ${imported_location_dir} NO_CACHE)
+  endif()
+  set(${VAR} "${imported_location_library}" PARENT_SCOPE)
+endfunction()
+
 #
 # Replace imported library target names with the library name.
 #
@@ -142,10 +176,9 @@ function(catkin_replace_imported_library_targets VAR)
           list(APPEND result ${${lib}_resolved_libs})
         endif()
       elseif(${${lib}_imported})
