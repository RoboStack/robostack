diff --git a/cmake/qt5_compat/robostack_qt5_common.cmake b/cmake/qt5_compat/robostack_qt5_common.cmake
new file mode 100644
index 0000000..0b14e44
--- /dev/null
+++ b/cmake/qt5_compat/robostack_qt5_common.cmake
@@ -0,0 +1,106 @@
+# RoboStack: RoboStack's noetic is built with Qt 6 (there is no Qt 5); this lets
+# packages that ask for Qt 5 (find_package(Qt5 COMPONENTS Widgets), find_package(Qt5Widgets))
+# build with Qt 6: Qt5::<Component> targets, the Qt5<Component>_* variables and the
+# qt5_* macros forward to Qt 6. Used through the Qt5*_DIR variables
+# robostack_qt5_compat.cmake sets when no real Qt 5 is installed.
+macro(_robostack_qt5_component _rs_qt5_c)
+  set(_rs_qt6_c ${_rs_qt5_c})
+  if("${_rs_qt5_c}" STREQUAL "OpenGL")
+    set(_rs_qt6_c OpenGL OpenGLWidgets)
+  elseif("${_rs_qt5_c}" STREQUAL "X11Extras")
+    set(_rs_qt6_c "")
+  endif()
+  find_package(Qt6 QUIET COMPONENTS Core ${_rs_qt6_c})
+  # Qt 5 APIs Qt 6 moved to Core5Compat (QRegExp, QStringRef, QTextCodec, ...)
+  find_package(Qt6 QUIET OPTIONAL_COMPONENTS Core5Compat)
+  set(_rs_found TRUE)
+  foreach(_rs_q ${_rs_qt6_c})
+    if(NOT Qt6${_rs_q}_FOUND)
+      set(_rs_found FALSE)
+    endif()
+  endforeach()
+  if(_rs_found)
+    if(NOT TARGET Qt5::${_rs_qt5_c})
+      add_library(Qt5::${_rs_qt5_c} INTERFACE IMPORTED)
+      foreach(_rs_q ${_rs_qt6_c})
+        set_property(TARGET Qt5::${_rs_qt5_c} APPEND PROPERTY INTERFACE_LINK_LIBRARIES Qt6::${_rs_q})
+      endforeach()
+      if(TARGET Qt6::Core5Compat)
+        set_property(TARGET Qt5::${_rs_qt5_c} APPEND PROPERTY INTERFACE_LINK_LIBRARIES Qt6::Core5Compat)
+      endif()
+    endif()
+    # the Qt 5 tool targets (Qt5::qmake, ...) as Qt 6's
+    foreach(_rs_tool qmake moc rcc uic)
+      if(TARGET Qt6::${_rs_tool} AND NOT TARGET Qt5::${_rs_tool})
+        get_target_property(_rs_loc Qt6::${_rs_tool} IMPORTED_LOCATION)
+        if(NOT _rs_loc)
+          get_target_property(_rs_loc Qt6::${_rs_tool} IMPORTED_LOCATION_RELEASE)
+        endif()
+        if(_rs_loc)
+          add_executable(Qt5::${_rs_tool} IMPORTED)
+          set_target_properties(Qt5::${_rs_tool} PROPERTIES IMPORTED_LOCATION "${_rs_loc}")
+        endif()
+      endif()
+    endforeach()
+    unset(_rs_loc)
+    set(Qt5${_rs_qt5_c}_FOUND TRUE)
+    set(Qt5${_rs_qt5_c}_LIBRARIES Qt5::${_rs_qt5_c})
+    set(Qt5${_rs_qt5_c}_INCLUDE_DIRS "")
+    set(_rs_with_compat Core ${_rs_qt6_c})
+    if(TARGET Qt6::Core5Compat)
+      list(APPEND _rs_with_compat Core5Compat)
+    endif()
+    foreach(_rs_q ${_rs_with_compat})
+      get_target_property(_rs_inc Qt6::${_rs_q} INTERFACE_INCLUDE_DIRECTORIES)
+      if(_rs_inc)
+        list(APPEND Qt5${_rs_qt5_c}_INCLUDE_DIRS ${_rs_inc})
+      endif()
+    endforeach()
+    list(REMOVE_DUPLICATES Qt5${_rs_qt5_c}_INCLUDE_DIRS)
+    set(Qt5${_rs_qt5_c}_DEFINITIONS "")
+    set(Qt5${_rs_qt5_c}_COMPILE_DEFINITIONS "")
+    set(Qt5${_rs_qt5_c}_EXECUTABLE_COMPILE_FLAGS "")
+    set(Qt5${_rs_qt5_c}_VERSION "${Qt6_VERSION}")
+    set(Qt5${_rs_qt5_c}_VERSION_STRING "${Qt6_VERSION}")
+    set(Qt5_VERSION "${Qt6_VERSION}")
+    set(Qt5_VERSION_MAJOR "${Qt6_VERSION_MAJOR}")
+    set(Qt5_VERSION_MINOR "${Qt6_VERSION_MINOR}")
+    set(Qt5_VERSION_PATCH "${Qt6_VERSION_PATCH}")
+  else()
+    set(Qt5${_rs_qt5_c}_FOUND FALSE)
+  endif()
+  unset(_rs_found)
+  unset(_rs_inc)
+  unset(_rs_q)
+  unset(_rs_qt6_c)
+  # Qt 5's components bring the ones they depend on (Qt5::Widgets: Qt5::Gui, Qt5::Core)
+  if(NOT "${_rs_qt5_c}" STREQUAL "Core" AND NOT TARGET Qt5::Core)
+    _robostack_qt5_component(Core)
+  endif()
+  if(NOT "${_rs_qt5_c}" MATCHES "^(Core|Gui)$" AND NOT TARGET Qt5::Gui AND TARGET Qt6::Gui)
+    _robostack_qt5_component(Gui)
+  endif()
+endmacro()
+
+if(NOT COMMAND qt5_wrap_cpp)
+  macro(qt5_wrap_cpp)
+    qt6_wrap_cpp(${ARGV})
+  endmacro()
+  macro(qt5_wrap_ui)
+    qt6_wrap_ui(${ARGV})
+  endmacro()
+  macro(qt5_add_resources)
+    qt6_add_resources(${ARGV})
+  endmacro()
+  # Qt 5's deprecated qt5_use_modules(target [LINK_PUBLIC|LINK_PRIVATE] modules...)
+  macro(qt5_use_modules _rs_target)
+    set(_rs_modules ${ARGN})
+    list(FILTER _rs_modules EXCLUDE REGEX "^LINK_(PUBLIC|PRIVATE)$")
+    foreach(_rs_m ${_rs_modules})
+      _robostack_qt5_component(${_rs_m})
+      target_link_libraries(${_rs_target} Qt5::${_rs_m})
+    endforeach()
+    unset(_rs_modules)
+    unset(_rs_m)
+  endmacro()
+endif()
diff --git a/cmake/robostack_cxx_standard.cmake b/cmake/robostack_cxx_standard.cmake
new file mode 100644
index 0000000..70853f6
--- /dev/null
+++ b/cmake/robostack_cxx_standard.cmake
@@ -0,0 +1,22 @@
+# RoboStack: conda-forge's libraries need C++17 (PCL 1.15, Sophus; Eigen 5 C++14), while
+# many ROS 1 packages ask for C++11 or C++14 (-std=c++11, CMAKE_CXX_STANDARD 14). A
+# request for a standard below C++17 is dropped, so these packages build with the
+# compiler's default (C++17, as the packages without a request do; with MSVC, whose
+# default is C++14, C++17 is set); newer requests stay. Run by find_package(catkin) and
+# catkin_package().
+function(_robostack_drop_old_cxx_standard)
+  if(DEFINED CMAKE_CXX_STANDARD AND "${CMAKE_CXX_STANDARD}" MATCHES "^(98|11|14)$")
+    set(CMAKE_CXX_STANDARD 17 PARENT_SCOPE)
+  elseif(MSVC AND NOT DEFINED CMAKE_CXX_STANDARD)
+    # MSVC's default is C++14, not C++17 as GCC's and clang's
+    set(CMAKE_CXX_STANDARD 17 PARENT_SCOPE)
+  endif()
+  set(_old "(-std=(c|gnu)\\+\\+(98|03|0x|11|1y|14)|/std:c\\+\\+14)")
+  string(REGEX REPLACE "(^| )${_old}( |$)" " " _flags "${CMAKE_CXX_FLAGS}")
+  set(CMAKE_CXX_FLAGS "${_flags}" PARENT_SCOPE)
+  get_directory_property(_options COMPILE_OPTIONS)
+  if(_options)
+    list(FILTER _options EXCLUDE REGEX "^${_old}$")
+    set_directory_properties(PROPERTIES COMPILE_OPTIONS "${_options}")
+  endif()
+endfunction()
diff --git a/cmake/robostack_eigen3.cmake b/cmake/robostack_eigen3.cmake
new file mode 100644
index 0000000..c9cbf72
--- /dev/null
+++ b/cmake/robostack_eigen3.cmake
@@ -0,0 +1,51 @@
+# RoboStack: conda-forge's Eigen 5 breaks how ROS 1 packages find Eigen:
+# - its CMake config only accepts version requests of its own major version
+#   (find_package(Eigen3 3.3) fails),
+# - copies of old FindEigen3.cmake modules can't read its version,
+# - it no longer sets EIGEN3_FOUND, EIGEN3_INCLUDE_DIR(S) and EIGEN3_VERSION_STRING.
+# After find_package(catkin), find_package(Eigen3 ...) therefore uses Eigen's CMake
+# config without the version and sets those variables; they are also set by
+# find_package(catkin) and catkin_package() when the headers are in the prefix.
+macro(_robostack_eigen3_variables)
+  if(Eigen3_FOUND AND TARGET Eigen3::Eigen AND NOT EIGEN3_INCLUDE_DIR)
+    get_target_property(EIGEN3_INCLUDE_DIR Eigen3::Eigen INTERFACE_INCLUDE_DIRECTORIES)
+  endif()
+  if(NOT EIGEN3_INCLUDE_DIR)
+    find_path(_robostack_eigen3_include_dir Eigen/Core PATH_SUFFIXES eigen3 NO_CACHE)
+    if(_robostack_eigen3_include_dir)
+      set(EIGEN3_INCLUDE_DIR "${_robostack_eigen3_include_dir}")
+    endif()
+    unset(_robostack_eigen3_include_dir)
+  endif()
+  if(EIGEN3_INCLUDE_DIR)
+    foreach(_robostack_var EIGEN3_INCLUDE_DIRS Eigen3_INCLUDE_DIR Eigen3_INCLUDE_DIRS)
+      if(NOT ${_robostack_var})
+        set(${_robostack_var} "${EIGEN3_INCLUDE_DIR}")
+      endif()
+    endforeach()
+    unset(_robostack_var)
+  endif()
+  if(Eigen3_FOUND)
+    set(EIGEN3_FOUND TRUE)
+    if(NOT EIGEN3_VERSION_STRING)
+      set(EIGEN3_VERSION_STRING "${Eigen3_VERSION}")
+      set(EIGEN3_VERSION "${Eigen3_VERSION}")
+    endif()
+  endif()
+endmacro()
+
+if(NOT COMMAND _robostack_find_package_override)
+  macro(_robostack_find_package_override)
+  endmacro()
+  macro(find_package _robostack_fp_name)
+    if("${_robostack_fp_name}" STREQUAL "Eigen3")
+      set(_robostack_fp_args ${ARGN})
+      list(FILTER _robostack_fp_args EXCLUDE REGEX "^([0-9]+(\\.[0-9]+)*(\\.\\.\\.<?[0-9.]+)?|EXACT|MODULE|NO_MODULE|CONFIG)$")
+      _find_package(Eigen3 ${_robostack_fp_args} CONFIG)
+      unset(_robostack_fp_args)
+      _robostack_eigen3_variables()
+    else()
+      _find_package(${_robostack_fp_name} ${ARGN})
+    endif()
+  endmacro()
+endif()
diff --git a/cmake/robostack_qt5_compat.cmake b/cmake/robostack_qt5_compat.cmake
new file mode 100644
index 0000000..03369ef
--- /dev/null
+++ b/cmake/robostack_qt5_compat.cmake
@@ -0,0 +1,14 @@
+# RoboStack: when no real Qt 5 is installed, find_package(Qt5 ...) and
+# find_package(Qt5<Component>) after find_package(catkin) use the Qt 6 forwarding
+# configs in qt5_compat/ (RoboStack's noetic is built with Qt 6).
+find_file(_robostack_real_qt5 Qt5Config.cmake PATH_SUFFIXES lib/cmake/Qt5 NO_CACHE)
+if(NOT _robostack_real_qt5)
+  foreach(_robostack_c "" Core Gui Widgets OpenGL Concurrent Xml Svg Network PrintSupport Test
+                       X11Extras WebSockets Multimedia Sql DBus)
+    if(NOT Qt5${_robostack_c}_DIR)
+      set(Qt5${_robostack_c}_DIR "${catkin_EXTRAS_DIR}/qt5_compat")
+    endif()
+  endforeach()
+  unset(_robostack_c)
+endif()
+unset(_robostack_real_qt5)
