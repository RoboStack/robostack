 #include <cassert>
 #include <cctype>
 #include <charconv>
+#include <cstdlib>
 #include <cstddef>
 #include <filesystem>
 #include <fstream>
@@ -347,10 +348,21 @@ auto parse_numeric(std::string_view& content_view) -> json {
 
   if (content_view[end_of_numeric] == 'e' || content_view[end_of_numeric] == '.') {  // is float
     double result{};
+#ifdef __APPLE__
+    // libc++ has no floating-point std::from_chars on macOS ("introduced in macOS 99.0")
+    const std::string number(content_view);
+    char * number_end = nullptr;
+    result = std::strtod(number.c_str(), &number_end);
+    if (number_end == number.c_str()) {
+      throw std::runtime_error("Failed to parse floating point value");
+    }
+    const char * ptr = content_view.data() + (number_end - number.c_str());
+#else
     auto [ptr, ec] = std::from_chars(content_view.data(), content_view.data() + content_view.size(), result);
     if (ec != std::errc()) {
       throw std::runtime_error("Failed to parse floating point value");
     }
+#endif
     content_view.remove_prefix(std::distance(content_view.data(), ptr));
     consume_white_space_and_comment(content_view);
     return result;
