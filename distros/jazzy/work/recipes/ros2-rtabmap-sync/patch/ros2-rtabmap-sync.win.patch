+# Windows: export CommonDataSubscriber explicitly (exporting every symbol of
+# rtabmap_sync exceeds the 65535 limit of an import library, LNK1189), and
+# everything of the plugins, whose node classes the executables construct.
+target_compile_definitions(rtabmap_sync PRIVATE RTABMAP_SYNC_BUILDING_DLL)
+set_target_properties(rtabmap_sync_plugins PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+
