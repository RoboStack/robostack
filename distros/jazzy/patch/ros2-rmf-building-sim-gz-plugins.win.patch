+++ b/include/rmf_building_sim_gz_plugins/components/Door.hpp
@@ -47,6 +47,9 @@ enum class DoorModeCmp
   OPEN = 2
 };
 
+// (MSVC) inside gz-sim's inline version namespace: a separate gz::sim::components next to
+// gz::sim::vN::components is ambiguous there (C2872), and Component/Factory aren't found
+inline namespace GZ_SIM_VERSION_NAMESPACE {
 namespace components {
 /// \brief A component used to describe an RMF door.
 using Door = Component<DoorData, class DoorTag>;
@@ -62,4 +65,5 @@ GZ_SIM_REGISTER_COMPONENT("rmf_components.DoorStateComp", DoorStateComp)
 }
 }
 }
+}
 #endif
