diff --git a/CMakeLists.txt b/CMakeLists.txt
index 279d989..7deeab2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,6 +1,12 @@
 cmake_minimum_required(VERSION 3.5)
 project(rmf_robot_sim_gz_plugins)
 
+if(MSVC)
+  # windows.h without WIN32_LEAN_AND_MEAN pulls in winsock.h, which then clashes with
+  # winsock2.h (C2011 sockaddr redefinition); NOMINMAX for windows.h's min/max macros
+  add_compile_definitions(WIN32_LEAN_AND_MEAN NOMINMAX _USE_MATH_DEFINES)
+endif()
+
 set (CMAKE_AUTOMOC ON)
 
 # Default to C99
diff --git a/src/TeleportDispenser.cpp b/src/TeleportDispenser.cpp
index 4dd81fa..f23f359 100644
--- a/src/TeleportDispenser.cpp
+++ b/src/TeleportDispenser.cpp
@@ -47,7 +47,9 @@ using namespace rmf_plugins_utils;
 
 namespace rmf_robot_sim_gz_plugins {
 
-class GZ_SIM_VISIBLE TeleportDispenserPlugin
+// (Windows) not GZ_SIM_VISIBLE: that is gz-sim's own export macro, dllimport here (LNK2019
+// on the vftable); GZ_ADD_PLUGIN exports the plugin
+class TeleportDispenserPlugin
   : public System,
   public ISystemConfigure,
   public ISystemPreUpdate
