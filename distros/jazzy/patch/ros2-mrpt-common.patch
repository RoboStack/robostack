     endif()
   endif()
 endfunction()
@@ -926,6 +929,15 @@ function(mrpt_add_python_module MODULE_NAME CPP_SOURCES)
   find_package(pybind11 QUIET)
   if (pybind11_FOUND)
     mrpt_ament_cmake_python_get_python_install_dir()
+    # RoboStack: conda's CMAKE_ARGS pass CMAKE_STRIP as a bare program name, which CMake
+    # turns into a path in the build directory; pybind11 strips the module with it.
+    if(CMAKE_STRIP AND NOT EXISTS "${CMAKE_STRIP}")
+      get_filename_component(_mrpt_strip_name "${CMAKE_STRIP}" NAME)
+      find_program(MRPT_PYBIND11_STRIP NAMES "${_mrpt_strip_name}")
+      if(MRPT_PYBIND11_STRIP)
+        set(CMAKE_STRIP "${MRPT_PYBIND11_STRIP}")
+      endif()
+    endif()
     pybind11_add_module(_bindings MODULE ${CPP_SOURCES})
     target_link_libraries(_bindings PRIVATE ${PROJECT_NAME})
