diff --git a/CMakeLists.txt b/CMakeLists.txt
index 330da79..ca48bb4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,17 +6,25 @@ endif()
 
 project(rmf_traffic_editor)
 
+if(MSVC)
+  # M_PI and friends: MSVC defines them only with _USE_MATH_DEFINES
+  add_compile_definitions(_USE_MATH_DEFINES)
+endif()
+
 find_package(ament_cmake REQUIRED)
 find_package(ament_index_cpp REQUIRED)
 find_package(Ceres REQUIRED)
 find_package(Eigen3 REQUIRED)
 find_package(Qt5 COMPONENTS Widgets Concurrent Test Network REQUIRED)
 find_package(yaml-cpp REQUIRED)
+find_package(PROJ CONFIG REQUIRED)
 
 set(CMAKE_BUILD_TYPE RelWithDebInfo)
 # set(CMAKE_VERBOSE_MAKEFILE TRUE)
 
-set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wshadow -Wextra")
+if(NOT MSVC)  # GCC/Clang warning flags; MSVC rejects -Wshadow (D8021)
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -Wall -Wshadow -Wextra")
+endif()
 
 set(CMAKE_AUTOMOC ON)
 set(CMAKE_AUTORCC ON)
@@ -120,8 +128,9 @@ target_link_libraries(
   Qt5::Widgets
   Qt5::Concurrent
   Qt5::Network
-  proj
-  yaml-cpp
+  # MSVC needs the imported targets (bare names mean proj.lib / yaml-cpp.lib, LNK1181)
+  PROJ::proj
+  yaml-cpp::yaml-cpp
   ${ament_index_cpp_LIBRARIES}
 )
 
