+    REQUIRED
   )
 endif()
 
@@ -61,6 +60,26 @@
   rtabmap_msgs
 )
 
+# RoboStack: with a Qt 5 RViz, keep Qt 6 out of this plugin. conda-forge's VTK links Qt 6
+# (VTK::GUISupportQt/RenderingQt, reached through PCL and rtabmap::core) and so does rtabmap's
+# GUI (rtabmap::gui, exported by rtabmap_conversions). The plugin uses none of them.
+if(Qt5_FOUND)
+  set(_rs_qt6_regex "Qt6::|VTK::GUISupportQt|VTK::RenderingQt|rtabmap::gui|pcl_visualization")
+  get_property(_rs_imported_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
+  foreach(_rs_target ${_rs_imported_targets})
+    get_target_property(_rs_libs ${_rs_target} INTERFACE_LINK_LIBRARIES)
+    if(_rs_libs)
+      list(FILTER _rs_libs EXCLUDE REGEX "${_rs_qt6_regex}")
+      set_property(TARGET ${_rs_target} PROPERTY INTERFACE_LINK_LIBRARIES "${_rs_libs}")
+    endif()
+  endforeach()
+  foreach(_rs_pkg ${AmentLibraries})
+    if(${_rs_pkg}_LIBRARIES)
+      list(FILTER ${_rs_pkg}_LIBRARIES EXCLUDE REGEX "${_rs_qt6_regex}")
+    endif()
+  endforeach()
+endif()
+
