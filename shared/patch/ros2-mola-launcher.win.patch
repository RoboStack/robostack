index 2bd97ff..d77ceda 100644
--- a/apps/mola-cli.cpp
+++ b/apps/mola-cli.cpp
@@ -23,7 +23,11 @@
 #include <mrpt/core/exceptions.h>
 #include <mrpt/rtti/CObject.h>
 #include <mrpt/system/filesystem.h>
+#if defined(_WIN32)
+#include <io.h>  // _write()
